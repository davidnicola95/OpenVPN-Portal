# Copy to .env and generate a unique secret before starting.
FLASK_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
BRAND_NAME=VPN Portal
VPN_PRIMARY_HOST=vpn.example.com
VPN_BACKUP_HOST=vpn-backup.example.com
VPN_PUBLIC_PORT=1194
EASYRSA_DIR=/etc/openvpn/easy-rsa
OPENVPN_DIR=/etc/openvpn
# Share this lock with any external CRL maintenance automation.
PKI_LOCK_PATH=/run/openvpn-pki.lock
OPENVPN_MANAGEMENT_HOST=127.0.0.1
OPENVPN_MANAGEMENT_PORT=7505
COOKIE_SECURE=true
LISTEN_HOST=127.0.0.1
PORT=5000
# Optional notification topic URL. Blank disables notifications.
NTFY_URL=
